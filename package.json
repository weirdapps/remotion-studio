    "react": "^19",
    "react-dom": "^19",
    "remotion": "^4"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": ">=8.5.10"
  }
}
